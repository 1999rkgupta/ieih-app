{
  "expo": {
    "name": "IEIH Esports",
    "slug": "ieih-esports",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070D",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07070D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ieih.esports"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07070D"
      },
      "package": "com.ieih.esports"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "5eaffce4-4564-4d3d-ab82-546fb17f6223"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
